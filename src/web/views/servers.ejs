<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lãnh Địa Quản Trị • SANGUINIS</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
    
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #08080a;
    }
    
    .font-arcane {
      font-family: 'Cinzel', serif;
    }

    ::-webkit-scrollbar { width: 6px; height: 6px; }
    ::-webkit-scrollbar-track { background: #08080a; }
    ::-webkit-scrollbar-thumb { background: #3b0d11; border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: #7f1d1d; }

    .glass-panel {
      background: linear-gradient(135deg, rgba(18, 18, 24, 0.9) 0%, rgba(13, 13, 18, 0.96) 100%);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(153, 27, 27, 0.3);
    }

    .server-card {
      background: linear-gradient(145deg, rgba(22, 22, 30, 0.85) 0%, rgba(14, 14, 20, 0.95) 100%);
      border: 1px solid rgba(153, 27, 27, 0.3);
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .server-card:hover {
      border-color: rgba(239, 68, 68, 0.6);
      transform: translateY(-2px);
      box-shadow: 0 10px 30px rgba(185, 28, 28, 0.25);
    }
  </style>
</head>
<body class="text-gray-200 min-h-screen flex flex-col selection:bg-red-900 selection:text-white">

  <!-- Ambient Blood Aura Background -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <div class="absolute top-0 right-1/4 w-[600px] h-[400px] bg-red-950/15 blur-3xl rounded-full"></div>
    <div class="absolute bottom-10 left-10 w-[500px] h-[400px] bg-red-900/10 blur-3xl rounded-full"></div>
  </div>

  <!-- Header Navigation -->
  <header class="relative z-20 w-full border-b border-red-950/70 bg-[#0d0d12]/90 backdrop-blur-xl sticky top-0">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-red-950 via-red-900 to-black border border-red-700/60 flex items-center justify-center text-xl shadow-[0_0_15px_rgba(220,38,38,0.3)] group-hover:scale-105 transition">
            🩸
          </div>
          <div>
            <h1 class="font-arcane tracking-[0.2em] text-white font-black text-lg leading-none">SANGUINIS</h1>
            <p class="text-[9px] tracking-[0.25em] uppercase text-red-500 font-semibold mt-0.5">Hội Kín Giám Sát</p>
          </div>
        </a>
      </div>

      <!-- User Profile & Action -->
      <div class="flex items-center gap-3 sm:gap-4">
        <div class="flex items-center gap-3 bg-[#121218] px-3 py-1.5 rounded-xl border border-red-950/80">
          <% if (user.avatar) { %>
            <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" class="w-8 h-8 rounded-full border border-red-900/60 object-cover" alt="<%= user.username %>">
          <% } else { %>
            <div class="w-8 h-8 rounded-full bg-red-950 flex items-center justify-center text-xs font-bold text-red-400 border border-red-900/60">
              <%= user.username.charAt(0).toUpperCase() %>
            </div>
          <% } %>
          <div class="hidden sm:block text-left">
            <p class="text-white text-xs font-bold leading-tight truncate max-w-[120px]"><%= user.username %></p>
            <p class="text-[10px] text-emerald-400 flex items-center gap-1"><span class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></span> Quyền Quản Trị</p>
          </div>
        </div>

        <a href="/logout" title="Đăng Xuất" class="h-10 w-10 rounded-xl bg-[#121218] hover:bg-red-950/60 border border-red-950/80 hover:border-red-600/50 text-gray-400 hover:text-red-400 flex items-center justify-center transition" aria-label="Đăng Xuất">
          <i class="fa-solid fa-arrow-right-from-bracket text-sm"></i>
        </a>
      </div>
    </div>
  </header>

  <!-- Main Content -->
  <main class="relative z-10 flex-1 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full">
    
    <!-- Hero Status Card -->
    <div class="glass-panel rounded-2xl p-6 sm:p-8 mb-8 border border-red-950/80 relative overflow-hidden">
      <div class="absolute -right-10 -bottom-10 text-9xl text-red-950/20 pointer-events-none select-none font-arcane">🩸</div>
      
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-950/70 border border-red-700/40 text-red-400 text-[11px] font-bold uppercase tracking-wider mb-3">
            <i class="fa-solid fa-crosshairs text-red-500"></i>
            <span>Trung Tâm Giám Sát Lãnh Địa</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-arcane tracking-wider uppercase mb-2">
            CHỌN MÁY CHỦ THIẾT LẬP
          </h2>
          <p class="text-xs sm:text-sm text-gray-400 max-w-2xl leading-relaxed">
            Danh sách các máy chủ Discord mà bạn nắm giữ thẩm quyền Quản Trị Viên (Administrator / Manage Server). Hãy chọn một máy chủ để kích hoạt hoặc tinh chỉnh 13 kênh Security Logs, Cổng chào mừng và Huyết Tháp XP.
          </p>
        </div>

        <div class="flex items-center gap-3 shrink-0">
          <a href="https://discord.com/api/oauth2/authorize?client_id=<%= clientId || '' %>&permissions=8&scope=bot%20applications.commands" target="_blank" class="h-11 px-5 rounded-xl bg-gradient-to-r from-red-950 via-red-900 to-red-800 hover:from-red-900 hover:to-red-700 border border-red-600/50 text-white font-bold text-xs uppercase tracking-wider flex items-center gap-2.5 transition shadow-[0_0_20px_rgba(220,38,38,0.3)]">
            <i class="fa-solid fa-plus text-amber-400"></i>
            <span>Thêm Bot Vào Server Mới</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Quick Stats Bar -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
      <div class="glass-panel p-4 rounded-xl border border-red-950/60 flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-lg bg-red-950/80 border border-red-800/40 flex items-center justify-center text-red-400 shrink-0">
          <i class="fa-solid fa-server"></i>
        </div>
        <div>
          <p class="text-[10px] uppercase font-bold text-gray-400 tracking-wider">Tổng Máy Chủ</p>
          <p class="text-xl font-black text-white"><%= adminGuilds.length %></p>
        </div>
      </div>

      <div class="glass-panel p-4 rounded-xl border border-red-950/60 flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-lg bg-red-950/80 border border-red-800/40 flex items-center justify-center text-emerald-400 shrink-0">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <div>
          <p class="text-[10px] uppercase font-bold text-gray-400 tracking-wider">Security Logs</p>
          <p class="text-xl font-black text-emerald-400">13 Kênh</p>
        </div>
      </div>

      <div class="glass-panel p-4 rounded-xl border border-red-950/60 flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-lg bg-red-950/80 border border-red-800/40 flex items-center justify-center text-amber-400 shrink-0">
          <i class="fa-solid fa-bolt"></i>
        </div>
        <div>
          <p class="text-[10px] uppercase font-bold text-gray-400 tracking-wider">Leveling System</p>
          <p class="text-xl font-black text-amber-400">Arcane XP</p>
        </div>
      </div>

      <div class="glass-panel p-4 rounded-xl border border-red-950/60 flex items-center gap-3.5">
        <div class="w-10 h-10 rounded-lg bg-red-950/80 border border-red-800/40 flex items-center justify-center text-red-500 shrink-0">
          <i class="fa-solid fa-heart-pulse"></i>
        </div>
        <div>
          <p class="text-[10px] uppercase font-bold text-gray-400 tracking-wider">Giao Thức</p>
          <p class="text-xl font-black text-white">Sanguinis 2.0</p>
        </div>
      </div>
    </div>

    <!-- Search / Filter Bar -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6">
      <div class="w-full sm:w-80 relative">
        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-500 text-xs"></i>
        <input type="text" id="server_search" placeholder="Tìm kiếm tên máy chủ..." class="w-full h-11 pl-10 pr-4 bg-[#121218] border border-red-950/80 rounded-xl text-base md:text-sm text-white placeholder-gray-500 focus:outline-none focus:border-red-600 transition">
      </div>
      <div class="text-xs text-gray-400 font-medium self-end sm:self-center">
        Hiển thị: <strong id="visible_count" class="text-red-400"><%= adminGuilds.length %></strong> máy chủ
      </div>
    </div>

    <!-- Server Grid -->
    <% if (adminGuilds && adminGuilds.length > 0) { %>
      <div id="servers_grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        <% adminGuilds.forEach(function(g) { %>
          <div class="server-item server-card rounded-2xl p-5 flex flex-col justify-between group" data-name="<%= g.name.toLowerCase() %>">
            <div class="flex items-start gap-4 mb-5">
              <% if (g.icon) { %>
                <img src="https://cdn.discordapp.com/icons/<%= g.id %>/<%= g.icon %>.png" class="w-14 h-14 rounded-2xl border border-red-900/60 object-cover shadow-[0_0_15px_rgba(220,38,38,0.2)] group-hover:border-red-600 transition" alt="<%= g.name %>">
              <% } else { %>
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-red-950 to-black border border-red-900/60 flex items-center justify-center text-lg font-black text-red-400 shadow-[0_0_15px_rgba(220,38,38,0.2)] group-hover:border-red-600 transition font-arcane">
                  <%= g.name.charAt(0).toUpperCase() %>
                </div>
              <% } %>
              
              <div class="flex-1 min-w-0">
                <h3 class="text-white font-bold text-sm truncate leading-snug group-hover:text-red-400 transition" title="<%= g.name %>">
                  <%= g.name %>
                </h3>
                <span class="inline-block mt-1 text-[10px] font-semibold text-gray-400 bg-red-950/40 px-2 py-0.5 rounded border border-red-900/30">
                  ID: <%= g.id.substring(0, 6) %>...
                </span>
              </div>
            </div>

            <div class="pt-3 border-t border-red-950/50 flex items-center justify-between gap-2">
              <span class="text-[11px] text-gray-400 flex items-center gap-1.5">
                <i class="fa-solid fa-crown text-amber-400 text-xs"></i> Administrator
              </span>
              <a href="/dashboard/<%= g.id %>" class="h-10 px-4 rounded-xl bg-gradient-to-r from-red-950 to-red-900 hover:from-red-900 hover:to-red-700 text-white font-bold text-xs uppercase tracking-wider flex items-center gap-2 border border-red-700/50 transition duration-150 shadow-[0_0_15px_rgba(220,38,38,0.25)]">
                <span>Quản Trị</span>
                <i class="fa-solid fa-chevron-right text-[10px]"></i>
              </a>
            </div>
          </div>
        <% }); %>
      </div>

      <div id="no_results" class="hidden text-center py-16">
        <div class="text-4xl mb-3">🔍</div>
        <p class="text-gray-400 text-sm">Không tìm thấy máy chủ nào khớp với từ khóa tìm kiếm.</p>
      </div>
    <% } else { %>
      <div class="glass-panel rounded-2xl p-12 text-center max-w-xl mx-auto border border-red-950/80">
        <div class="w-16 h-16 rounded-2xl bg-red-950/80 border border-red-800/40 flex items-center justify-center text-3xl mx-auto mb-4 text-red-500">
          ⚠️
        </div>
        <h3 class="font-arcane text-xl font-bold text-white uppercase mb-2">Chưa Có Máy Chủ Khả Dụng</h3>
        <p class="text-xs text-gray-400 mb-6 leading-relaxed">
          Tài khoản Discord của bạn hiện chưa có quyền Quản Trị Viên (Administrator) tại máy chủ nào, hoặc bạn chưa tạo máy chủ riêng.
        </p>
        <a href="https://discord.com/api/oauth2/authorize?client_id=<%= clientId || '' %>&permissions=8&scope=bot%20applications.commands" target="_blank" class="inline-flex items-center gap-2 h-11 px-6 rounded-xl bg-gradient-to-r from-red-950 to-red-800 text-white font-bold text-xs uppercase tracking-wider border border-red-600/50">
          <i class="fa-solid fa-plus text-amber-400"></i>
          <span>Thêm Bot Vào Máy Chủ Mới</span>
        </a>
      </div>
    <% } %>

  </main>

  <!-- Global Footer -->
  <footer class="relative z-10 w-full border-t border-red-950/60 bg-[#08080a]/90 backdrop-blur-xl py-5 mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-gray-500">
      <div class="flex items-center gap-2">
        <span class="text-red-500 font-bold">🩸 SANGUINIS AUDIT PROTOCOL</span>
        <span>•</span>
        <span>Lãnh Địa Giám Sát</span>
      </div>
      <div class="text-gray-600 text-[11px] font-mono">
        OBSIDIAN BLACK • DARK CRIMSON GLASSMORPHISM
      </div>
    </div>
  </footer>

  <script>
    const searchInput = document.getElementById('server_search');
    const items = document.querySelectorAll('.server-item');
    const noResults = document.getElementById('no_results');
    const countDisplay = document.getElementById('visible_count');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const val = e.target.value.toLowerCase().trim();
        let visible = 0;
        items.forEach((item) => {
          const name = item.getAttribute('data-name');
          if (name.includes(val)) {
            item.classList.remove('hidden');
            visible++;
          } else {
            item.classList.add('hidden');
          }
        });

        if (countDisplay) countDisplay.textContent = visible;
        if (noResults) {
          if (visible === 0 && items.length > 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      });
    }
  </script>
</body>
</html>
