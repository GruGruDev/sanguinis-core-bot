<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <title>Tổng Quan - Sanguinis Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-[#0b0e14] text-gray-300 font-sans h-screen flex flex-col overflow-hidden">

  <!-- TOP NAVBAR -->
  <nav class="h-16 bg-[#10141d] border-b border-gray-800/80 flex items-center justify-between px-6 shrink-0">
    <div class="flex items-center gap-12">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-red-900/80 flex items-center justify-center text-red-500 font-bold">🩸</div>
        <div>
          <h1 class="font-black text-white text-lg leading-none">SANGUINIS <span class="text-red-500 text-xs">●</span></h1>
          <p class="text-[9px] text-red-400 uppercase tracking-widest">Open-source • Cộng đồng Việt Nam</p>
        </div>
      </div>
      <div class="hidden md:flex gap-6 text-sm font-medium">
        <a href="/dashboard" class="text-blue-400 flex flex-col items-center gap-1 border-b-2 border-blue-400 pb-1"><i class="fa-solid fa-house"></i> Tổng quan</a>
        <a href="#" class="text-gray-400 hover:text-white flex flex-col items-center gap-1 pb-1"><i class="fa-solid fa-server"></i> Máy chủ</a>
        <a href="#" class="text-gray-400 hover:text-white flex flex-col items-center gap-1 pb-1"><i class="fa-solid fa-terminal"></i> Lệnh</a>
        <a href="#" class="text-gray-400 hover:text-white flex flex-col items-center gap-1 pb-1"><i class="fa-solid fa-gear"></i> Cài đặt</a>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-3 bg-[#1a1f2e] px-3 py-1.5 rounded-lg border border-gray-800 cursor-pointer">
        <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png" class="w-8 h-8 rounded-full">
        <div>
          <p class="text-white text-sm font-bold leading-none"><%= user.username %></p>
          <p class="text-[10px] text-emerald-400 flex items-center gap-1"><span class="w-1.5 h-1.5 bg-emerald-400 rounded-full"></span> Online</p>
        </div>
        <i class="fa-solid fa-chevron-down text-xs ml-2 text-gray-500"></i>
      </div>
    </div>
  </nav>

  <div class="flex flex-1 overflow-hidden">
    <!-- LEFT SIDEBAR (Danh sách server) -->
    <aside class="w-64 bg-[#10141d] border-r border-gray-800/80 flex flex-col p-4 shrink-0 overflow-y-auto">
      <button class="w-full flex items-center gap-3 p-3 rounded-xl hover:bg-[#1a1f2e] text-gray-400 transition mb-4 border border-dashed border-gray-700">
        <i class="fa-solid fa-plus text-blue-400"></i> <span class="font-medium text-sm">Thêm server</span>
      </button>
      
      <div class="space-y-1 overflow-y-auto flex-1">
        <% adminGuilds.forEach(function(g) { %>
          <a href="/dashboard/<%= g.id %>" class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-[#1a1f2e] transition group">
            <% if(g.icon) { %>
              <img src="https://cdn.discordapp.com/icons/<%= g.id %>/<%= g.icon %>.png" class="w-8 h-8 rounded-full border border-gray-700 group-hover:border-red-500 transition">
            <% } else { %>
              <div class="w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center text-xs font-bold text-white border border-gray-700 group-hover:border-red-500"><%= g.name.charAt(0) %></div>
            <% } %>
            <span class="text-sm font-medium text-gray-300 group-hover:text-white truncate"><%= g.name %></span>
          </a>
        <% }); %>
      </div>
    </aside>

    <!-- MAIN CENTER -->
    <main class="flex-1 p-6 overflow-y-auto">
      <div class="bg-[#1a1f2e] border border-gray-800 rounded-2xl p-6 mb-6 flex items-center gap-6">
        <div class="w-20 h-20 rounded-full bg-red-900/30 flex items-center justify-center text-4xl text-red-500 shrink-0 shadow-lg shadow-red-900/20">🩸</div>
        <div>
          <h2 class="text-2xl font-bold text-white mb-2 flex items-center gap-3">Chào mừng đến SANGUINIS Dashboard <span class="text-xs bg-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded-full border border-emerald-500/30"><i class="fa-solid fa-circle text-[8px]"></i> Online</span></h2>
          <p class="text-gray-400 text-sm mb-3">Bot Discord mã nguồn mở dành cho cộng đồng Việt Nam.</p>
          <div class="flex gap-4 text-xs font-medium text-gray-300">
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-server text-red-400"></i> Máy chủ: <%= adminGuilds.length %></span>
            <span class="flex items-center gap-1.5"><i class="fa-solid fa-users text-blue-400"></i> Mở rộng chức năng</span>
          </div>
        </div>
      </div>

      <h3 class="text-white font-bold mb-4 flex items-center gap-2"><i class="fa-solid fa-chart-simple"></i> Tổng quan thống kê</h3>
      <div class="grid grid-cols-4 gap-4 mb-8">
        <div class="bg-[#10141d] border border-gray-800 p-4 rounded-xl">
          <i class="fa-solid fa-server text-red-400 mb-2 text-lg"></i>
          <p class="text-gray-400 text-xs font-medium">Số máy chủ quản lý</p>
          <h4 class="text-2xl font-bold text-white"><%= adminGuilds.length %></h4>
        </div>
        <div class="bg-[#10141d] border border-gray-800 p-4 rounded-xl">
          <i class="fa-solid fa-shield-halved text-blue-400 mb-2 text-lg"></i>
          <p class="text-gray-400 text-xs font-medium">Độ bảo mật</p>
          <h4 class="text-2xl font-bold text-white">Toàn diện</h4>
        </div>
        <div class="bg-[#10141d] border border-gray-800 p-4 rounded-xl">
          <i class="fa-solid fa-bolt text-amber-400 mb-2 text-lg"></i>
          <p class="text-gray-400 text-xs font-medium">Hệ thống Leveling</p>
          <h4 class="text-2xl font-bold text-white">Sẵn sàng</h4>
        </div>
        <div class="bg-[#10141d] border border-gray-800 p-4 rounded-xl">
          <i class="fa-solid fa-heart-pulse text-emerald-400 mb-2 text-lg"></i>
          <p class="text-gray-400 text-xs font-medium">Uptime</p>
          <h4 class="text-2xl font-bold text-white">99.9%</h4>
        </div>
      </div>
    </main>

    <!-- RIGHT SIDEBAR -->
    <aside class="w-72 bg-[#10141d] border-l border-gray-800/80 p-6 shrink-0 overflow-y-auto">
      <h3 class="text-white font-bold mb-4 flex items-center gap-2"><i class="fa-solid fa-bolt text-amber-400"></i> Hành động nhanh</h3>
      <div class="space-y-3 mb-8">
        <a href="#" class="flex items-center justify-between bg-blue-600 hover:bg-blue-500 text-white p-3 rounded-xl font-medium text-sm transition">
          <span class="flex items-center gap-3"><i class="fa-solid fa-plus-circle"></i> Thêm bot vào server</span>
          <i class="fa-solid fa-chevron-right text-xs"></i>
        </a>
        <a href="#" class="flex items-center justify-between bg-[#1a1f2e] hover:bg-[#252b3d] border border-gray-800 text-gray-300 p-3 rounded-xl font-medium text-sm transition">
          <span class="flex items-center gap-3"><i class="fa-solid fa-list"></i> Xem lệnh</span>
          <i class="fa-solid fa-chevron-right text-xs"></i>
        </a>
      </div>

      <div class="bg-[#1a1f2e] border border-gray-800 rounded-xl p-5 mb-6">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-8 h-8 rounded-full bg-red-900/50 flex items-center justify-center text-red-500"><i class="fa-solid fa-droplet"></i></div>
          <h4 class="font-bold text-white">Về SANGUINIS</h4>
        </div>
        <p class="text-xs text-gray-400 leading-relaxed mb-3">SANGUINIS là bot Discord mã nguồn mở, được xây dựng bởi và dành cho cộng đồng Việt Nam.</p>
        <a href="#" class="text-red-400 hover:text-red-300 text-xs font-medium">Tìm hiểu thêm &rarr;</a>
      </div>
    </aside>
  </div>
</body>
</html>