                    <span>🚪</span> DM Khi Rời Server
                  </span>
                  
                  <div class="flex items-center gap-3">
                    <button type="button" onclick="sendCustomTest('dm-leave')" class="h-8 px-2.5 rounded-lg bg-[#181824] hover:bg-[#252538] border border-gray-700 text-gray-300 text-[11px] font-bold uppercase transition">
