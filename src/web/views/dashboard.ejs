                <% }) %>
              </select>
              <p class="text-[11px] text-gray-500 mt-1.5">Mọi thành viên mới hợp lệ sẽ tự động được ban tặng các vai trò này ngay khi bước qua cổng.</p>
            </div>
          </div>
        </div>

