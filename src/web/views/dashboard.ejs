                <label class="block text-xs font-bold text-gray-300 uppercase tracking-wider mb-2">🖼️ URL Banner / GIF Tạm Biệt</label>
                <input type="url" id="input_leave_banner" name="leaveBannerUrl" value="<%= config.leave_banner_url || '' %>" placeholder="https://i.imgur.com/example.gif" class="w-full h-11 bg-[#101016] border border-red-950/80 rounded-xl px-3 text-base md:text-sm text-white focus:border-red-600 focus:outline-none">
              </div>
            </div>

            <!-- Live Banner Preview Box -->
            <div>
              <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1.5">Khung Xem Trước Banner Tạm Biệt</label>
              <div class="w-full h-36 sm:h-44 rounded-xl bg-[#0a0a0f] border border-red-950/70 overflow-hidden flex items-center justify-center relative">
