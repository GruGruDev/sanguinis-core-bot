              </div>
            </div>
          </div>
        </div>

        <!-- ================= TAB 3: 🛡️ PHÒNG TUYẾN BẢO MẬT & ANTI-RAID ================= -->
        <div id="tab_defense" class="tab-pane hidden space-y-6">
          <div class="pb-3 border-b border-red-950/60">
            <h3 class="font-arcane text-lg font-bold text-white flex items-center gap-2 uppercase tracking-wide">
              <span>🛡️</span> PHÒNG TUYẾN BẢO MẬT & THANH TRỪNG CLONE
            </h3>
            <p class="text-xs text-gray-400 mt-0.5">Bộ quy chuẩn cách ly tài khoản clone, cấp ấn Verify và đồng bộ Voice Counter quân số theo thời gian thực.</p>
          </div>

          <div class="glass-card rounded-2xl p-5 sm:p-6 space-y-6">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
              
              <!-- Anti-Alt Days -->
              <div>
                <label class="block text-xs font-bold text-gray-300 uppercase tracking-wider mb-2">⏳ Tuổi Acc Tối Thiểu (Anti-Alt)</label>
                <div class="flex items-center">
                  <input type="number" name="accountAgeDays" value="<%= config.account_age_days || 0 %>" min="0" class="w-full h-11 bg-[#101016] border border-red-950/80 rounded-l-xl px-3 text-base md:text-sm text-white focus:border-red-600 focus:outline-none">
                  <span class="h-11 px-4 bg-red-950/80 border border-l-0 border-red-950/80 rounded-r-xl text-red-300 text-xs font-bold flex items-center">Ngày</span>
                </div>
                <p class="text-[11px] text-gray-500 mt-1.5">Tài khoản mới tạo dưới số ngày này sẽ bị trục xuất tự động ngay khi vừa bước vào server.</p>
              </div>

              <!-- Verify Role -->
              <div>
                <label class="block text-xs font-bold text-gray-300 uppercase tracking-wider mb-2">✅ Role Cấp Sau Khi Verify</label>
                <select name="verifyRoleId" class="w-full h-11 bg-[#101016] border border-red-950/80 rounded-xl px-3 text-base md:text-sm text-white focus:border-red-600 focus:outline-none">
                  <option value="">-- Tắt Xác Minh (None) --</option>
                  <% roles.forEach(function(r) { %>
                    <option value="<%= r.id %>" <%= config.verify_role_id === r.id ? 'selected' : '' %>>@<%= r.name %></option>
                  <% }) %>
                </select>
                <p class="text-[11px] text-gray-500 mt-1.5">Vai trò được trao khi thành viên vượt qua bước kiểm chứng phòng tuyến.</p>
              </div>

              <!-- Voice Counter -->
              <div>
                <label class="block text-xs font-bold text-gray-300 uppercase tracking-wider mb-2">🔊 Kênh Voice Counter Quân Số</label>
                <select name="memberCountChannelId" class="w-full h-11 bg-[#101016] border border-red-950/80 rounded-xl px-3 text-base md:text-sm text-white focus:border-red-600 focus:outline-none">
                  <option value="">-- Tắt Bộ Đếm Voice --</option>
                  <% voiceChannels.forEach(function(vc) { %>
                    <option value="<%= vc.id %>" <%= config.member_count_channel_id === vc.id ? 'selected' : '' %>>🔊 <%= vc.name %></option>
                  <% }) %>
                </select>
                <p class="text-[11px] text-gray-500 mt-1.5">Tên kênh thoại sẽ tự đổi thành "👥 Thành Viên: [Số lượng]" mỗi khi có biến động.</p>
              </div>

            </div>

            <!-- Auto Roles -->
            <div class="pt-4 border-t border-red-950/50">
              <label class="block text-xs font-bold text-amber-400 uppercase tracking-wider mb-2">🏷️ AutoRoles Mặc Định (Giữ Ctrl / Cmd để chọn nhiều)</label>
              <select name="autoRoles" multiple class="w-full bg-[#101016] border border-red-950/80 rounded-xl p-3 text-base md:text-sm text-white h-32 focus:border-red-600 focus:outline-none">
