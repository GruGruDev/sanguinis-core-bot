              <div>
                <label class="block text-[11px] font-bold text-gray-300 uppercase tracking-wider mb-1.5">🎁 Tên Chiến Lợi Phẩm</label>
                <input type="text" id="gw_prize" placeholder="Ví dụ: Role Arcane VIP, Nitro, 100k VNĐ" class="w-full h-11 bg-[#101016] border border-red-950/80 rounded-xl px-3 text-base md:text-sm text-white focus:border-red-600 focus:outline-none">
              </div>

              <div>
                <label class="block text-[11px] font-bold text-gray-300 uppercase tracking-wider mb-1.5">⏱️ Thời Hạn (10m, 2h, 1d)</label>
                <input type="text" id="gw_duration" placeholder="10m, 2h, 1d" class="w-full h-11 bg-[#101016] border border-red-950/80 rounded-xl px-3 text-base md:text-sm text-white focus:border-red-600 focus:outline-none">
              </div>

              <div>
                <label class="block text-[11px] font-bold text-gray-300 uppercase tracking-wider mb-1.5">🏆 Số Lượng Giải Thắng</label>
                <input type="number" id="gw_winners" value="1" min="1" class="w-full h-11 bg-[#101016] border border-red-950/80 rounded-xl px-3 text-base md:text-sm text-white focus:border-red-600 focus:outline-none">
              </div>
            </div>

            <!-- Advanced Participation Conditions -->
            <h4 class="text-xs font-bold text-amber-400 uppercase tracking-wider pt-3 border-t border-red-950/50 flex items-center gap-2">
              <i class="fa-solid fa-filter"></i> 2. Rào Cản Tham Gia Nâng Cao
            </h4>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              <div>
                <label class="block text-[11px] font-bold text-gray-300 uppercase tracking-wider mb-1.5">👑 Role Bắt Buộc Phải Có</label>
                <select id="gw_req_role" class="w-full h-11 bg-[#101016] border border-red-950/80 rounded-xl px-3 text-base md:text-sm text-white focus:border-amber-500 focus:outline-none">
                  <option value="">-- Không yêu cầu --</option>
                  <% roles.forEach(function(r) { %>
                    <option value="<%= r.id %>">@<%= r.name %></option>
                  <% }) %>
                </select>
              </div>

              <div>
                <label class="block text-[11px] font-bold text-gray-300 uppercase tracking-wider mb-1.5">⏳ Tuổi Acc Tối Thiểu (Ngày)</label>
                <input type="number" id="gw_min_acc" value="0" min="0" class="w-full h-11 bg-[#101016] border border-red-950/80 rounded-xl px-3 text-base md:text-sm text-white focus:border-amber-500 focus:outline-none">
              </div>

              <div>
                <label class="block text-[11px] font-bold text-gray-300 uppercase tracking-wider mb-1.5">📌 Đã Vào Server Tối Thiểu (Giờ)</label>
                <input type="number" id="gw_min_server" value="0" min="0" class="w-full h-11 bg-[#101016] border border-red-950/80 rounded-xl px-3 text-base md:text-sm text-white focus:border-amber-500 focus:outline-none">
              </div>

              <div>
                <label class="block text-[11px] font-bold text-gray-300 uppercase tracking-wider mb-1.5">⚡ Level Tối Thiểu</label>
                <input type="number" id="gw_min_level" value="0" min="0" class="w-full h-11 bg-[#101016] border border-red-950/80 rounded-xl px-3 text-base md:text-sm text-white focus:border-amber-500 focus:outline-none">
              </div>

              <div>
                <label class="block text-[11px] font-bold text-gray-300 uppercase tracking-wider mb-1.5">💬 Số Tin Nhắn Tối Thiểu</label>
                <input type="number" id="gw_min_messages" value="0" min="0" class="w-full h-11 bg-[#101016] border border-red-950/80 rounded-xl px-3 text-base md:text-sm text-white focus:border-amber-500 focus:outline-none">
              </div>

              <div>
                <label class="block text-[11px] font-bold text-gray-300 uppercase tracking-wider mb-1.5">👥 Số Người Tham Gia Tối Thiểu</label>
                <input type="number" id="gw_min_participants" value="0" min="0" class="w-full h-11 bg-[#101016] border border-red-950/80 rounded-xl px-3 text-base md:text-sm text-white focus:border-amber-500 focus:outline-none">
              </div>
            </div>

            <!-- Rigged Winners Selection -->
            <h4 class="text-xs font-bold text-purple-400 uppercase tracking-wider pt-3 border-t border-red-950/50 flex items-center gap-2">
              <i class="fa-solid fa-dice text-purple-400"></i> 3. Chỉ Định Người Thắng Cuộc (Mặc Định Ngẫu Nhiên)
            </h4>
            <div id="rigged_container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>

            <div class="pt-2">
              <button type="button" onclick="createGiveaway()" class="h-12 px-6 rounded-xl bg-gradient-to-r from-red-900 via-red-800 to-red-600 hover:from-red-800 hover:to-red-500 text-white font-bold text-xs uppercase tracking-wider flex items-center gap-2 transition shadow-[0_0_20px_rgba(220,38,38,0.35)] border border-red-500/40">
                <i class="fa-solid fa-gift text-sm"></i>
                <span>Phát Khởi Sự Kiện Giveaway</span>
              </button>
            </div>
          </div>

          <!-- Existing Giveaways List -->
          <div class="space-y-4">
            <h4 class="font-arcane text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span>📋</span> Danh Sách Sự Kiện Hiện Tại
            </h4>

            <% if (giveaways && giveaways.length > 0) { %>
              <!-- PC Table View (hidden on mobile) -->
              <div class="hidden md:block glass-card rounded-2xl overflow-hidden border border-red-950/80">
                <table class="w-full text-left border-collapse text-xs text-gray-300">
                  <thead>
                    <tr class="border-b border-red-950/80 bg-[#121218] text-gray-400 uppercase tracking-wider text-[10px]">
                      <th class="py-3 px-4">Phần Thưởng</th>
                      <th class="py-3 px-4">Số Giải</th>
                      <th class="py-3 px-4">Trạng Thái</th>
                      <th class="py-3 px-4 text-right">Hành Động</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-red-950/40">
                    <% giveaways.forEach(function(gw) { %>
                      <tr class="hover:bg-red-950/20 transition">
                        <td class="py-3 px-4 font-bold text-white"><%= gw.prize %></td>
                        <td class="py-3 px-4 text-amber-400 font-mono"><%= gw.winners_count %> Người</td>
                        <td class="py-3 px-4">
                          <% if (gw.ended === 1) { %>
                            <span class="px-2.5 py-1 text-[10px] rounded-full bg-gray-800 text-gray-400 font-bold uppercase tracking-wider">Đã Kết Thúc</span>
                          <% } else { %>
                            <span class="px-2.5 py-1 text-[10px] rounded-full bg-emerald-950/60 text-emerald-400 border border-emerald-500/30 font-bold uppercase tracking-wider animate-pulse">Đang Chạy</span>
                          <% } %>
                        </td>
                        <td class="py-3 px-4 text-right space-x-1.5">
                          <% if (gw.ended === 0) { %>
                            <button type="button" onclick="endGiveaway('<%= gw.message_id %>')" class="h-8 px-3 bg-red-950 hover:bg-red-800 text-red-200 border border-red-700/60 rounded-lg text-xs font-bold transition">
                              Kết Thúc Ngay
                            </button>
                          <% } else { %>
                            <button type="button" onclick="rerollGiveaway('<%= gw.message_id %>')" class="h-8 px-3 bg-amber-950/80 hover:bg-amber-800 text-amber-200 border border-amber-700/60 rounded-lg text-xs font-bold transition">
                              <i class="fa-solid fa-rotate"></i> Reroll
                            </button>
                          <% } %>
                          <button type="button" onclick="deleteGiveaway('<%= gw.message_id %>')" class="h-8 px-3 bg-[#161620] hover:bg-red-950 text-gray-400 hover:text-red-400 border border-red-950 rounded-lg text-xs font-bold transition">
                            <i class="fa-solid fa-trash"></i>
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>

              <!-- Mobile Stacked Cards View (< md) -->
              <div class="md:hidden space-y-3">
                <% giveaways.forEach(function(gw) { %>
                  <div class="glass-card rounded-xl p-4 border border-red-950/80 space-y-2.5">
                    <div class="flex items-start justify-between gap-2">
                      <h5 class="font-bold text-white text-sm"><%= gw.prize %></h5>
                      <% if (gw.ended === 1) { %>
                        <span class="px-2 py-0.5 text-[9px] rounded-full bg-gray-800 text-gray-400 font-bold uppercase shrink-0">Đã Kết Thúc</span>
                      <% } else { %>
                        <span class="px-2 py-0.5 text-[9px] rounded-full bg-emerald-950/60 text-emerald-400 border border-emerald-500/30 font-bold uppercase shrink-0 animate-pulse">Đang Chạy</span>
                      <% } %>
                    </div>
                    <div class="text-[11px] text-gray-400 flex items-center justify-between">
                      <span>Số giải: <strong class="text-amber-400"><%= gw.winners_count %> Người</strong></span>
                    </div>
                    <div class="pt-2 border-t border-red-950/50 flex items-center justify-end gap-2">
                      <% if (gw.ended === 0) { %>
                        <button type="button" onclick="endGiveaway('<%= gw.message_id %>')" class="h-9 px-3 bg-red-950 hover:bg-red-800 text-red-200 border border-red-700/60 rounded-lg text-xs font-bold transition">
                          Kết Thúc Ngay
                        </button>
                      <% } else { %>
                        <button type="button" onclick="rerollGiveaway('<%= gw.message_id %>')" class="h-9 px-3 bg-amber-950 hover:bg-amber-800 text-amber-200 border border-amber-700/60 rounded-lg text-xs font-bold transition">
                          <i class="fa-solid fa-rotate"></i> Reroll
                        </button>
                      <% } %>
                      <button type="button" onclick="deleteGiveaway('<%= gw.message_id %>')" class="h-9 px-3 bg-[#161620] hover:bg-red-950 text-red-400 border border-red-950 rounded-lg text-xs font-bold transition">
                        <i class="fa-solid fa-trash"></i> Xóa
                      </button>
                    </div>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <div class="glass-card rounded-2xl p-8 text-center text-xs text-gray-500 italic">
                Chưa có sự kiện Giveaway nào được ghi nhận tại máy chủ này.
              </div>
            <% } %>
          </div>

          <!-- Giveaway History Table -->
          <div class="space-y-4 pt-4 border-t border-red-950/50">
            <h4 class="font-arcane text-sm font-bold text-amber-400 uppercase tracking-wider flex items-center gap-2">
              <i class="fa-solid fa-clock-rotate-left"></i> Lịch Sử Trao Thưởng
            </h4>

            <% if (history && history.length > 0) { %>
              <div class="glass-card rounded-2xl overflow-hidden border border-red-950/80">
                <div class="overflow-x-auto">
                  <table class="w-full text-left border-collapse text-xs text-gray-300 min-w-[500px]">
                    <thead>
                      <tr class="border-b border-red-950/80 bg-[#121218] text-gray-400 uppercase tracking-wider text-[10px]">
                        <th class="py-3 px-4">Chiến Lợi Phẩm</th>
                        <th class="py-3 px-4">Người Nhận Giải</th>
                        <th class="py-3 px-4">Người Trao</th>
                        <th class="py-3 px-4 text-right">Thời Gian</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-red-950/40">
                      <% history.forEach(function(h) { %>
                        <tr class="hover:bg-red-950/20 transition">
                          <td class="py-2.5 px-4 font-bold text-amber-400"><%= h.prize %></td>
                          <td class="py-2.5 px-4 text-emerald-400 font-medium">🎁 <%= h.winner_tag %> (<%= h.winner_id %>)</td>
                          <td class="py-2.5 px-4 text-gray-300">👑 <%= h.hosted_by %></td>
                          <td class="py-2.5 px-4 text-right text-gray-500 font-mono"><%= h.created_at %></td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>
            <% } else { %>
              <div class="glass-card rounded-2xl p-6 text-center text-xs text-gray-500 italic">
                Chưa có lịch sử trao thưởng nào.
              </div>
            <% } %>
          </div>

        </div>

      </form>
    </main>
  </div>

  <!-- ================= FIXED BOTTOM ACTION DOCK (< 1024px) ================= -->
  <div class="lg:hidden fixed bottom-0 left-0 right-0 h-16 bg-[#0a0a0e]/95 backdrop-blur-xl border-t border-red-950/80 px-4 flex items-center justify-between z-40">
    <div class="flex items-center gap-2">
      <span id="mobile_unsaved_indicator" class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span id="mobile_save_text" class="text-xs font-semibold text-gray-300">Đã đồng bộ</span>
    </div>

    <button type="button" onclick="submitConfiguration(event)" class="h-11 px-6 rounded-xl bg-gradient-to-r from-red-900 via-red-800 to-red-600 text-white font-bold text-xs uppercase tracking-wider flex items-center gap-2 shadow-[0_0_20px_rgba(220,38,38,0.5)] border border-red-500/40 animate-pulse">
      <i class="fa-solid fa-floppy-disk text-sm"></i>
      <span>Lưu Cấu Hình</span>
    </button>
  </div>

  <!-- Guild Members Data JSON -->
  <script id="guild-members-data" type="application/json">
    <%- JSON.stringify(guildMembers || []) %>
  </script>

  <!-- Dashboard JavaScript Logic -->
  <script>
    // SweetAlert2 Custom Dark Blood Config
    const sanguinisSwal = Swal.mixin({
      customClass: {
        popup: 'sanguinis-swal',
        confirmButton: 'swal2-confirm',
        cancelButton: 'swal2-cancel',
      },
      buttonsStyling: false,
      backdrop: 'rgba(5, 5, 8, 0.75)',
      allowOutsideClick: true,
      color: '#fef2f2',
      background: '#09090b',
      confirmButtonText: 'Đồng ý',
      cancelButtonText: 'Hủy',
      reverseButtons: true,
    });

    function showSanguinisAlert({ icon = 'success', title = 'Thông báo', text = '', confirmButtonText = 'Đồng ý' } = {}) {
      return sanguinisSwal.fire({
        icon,
        title,
        text,
        confirmButtonText,
      });
    }

    function confirmSanguinisAction(title, text, callback) {
      sanguinisSwal
        .fire({
          icon: 'warning',
          title,
          text,
          showCancelButton: true,
          confirmButtonText: 'Xác nhận',
          cancelButtonText: 'Hủy',
        })
        .then((result) => {
          if (result.isConfirmed && typeof callback === 'function') {
            callback();
          }
        });
    }

    // Tab Switching Without Reload
    function switchTab(tabId) {
      document.querySelectorAll('.tab-pane').forEach((el) => el.classList.add('hidden'));
      document.querySelectorAll('.tab-btn').forEach((btn) => {
        btn.classList.remove('active');
        btn.classList.add('bg-[#121218]/80', 'text-gray-400');
      });

      const activePane = document.getElementById(tabId);
      if (activePane) activePane.classList.remove('hidden');

      const activeBtn = document.getElementById('btn_' + tabId);
      if (activeBtn) {
        activeBtn.classList.add('active');
        activeBtn.classList.remove('bg-[#121218]/80', 'text-gray-400');
      }

      window.location.hash = tabId;
    }

    // Auto load tab from hash if present
    window.addEventListener('DOMContentLoaded', () => {
      const hash = window.location.hash.replace('#', '');
      if (hash && document.getElementById(hash)) {
        switchTab(hash);
      }
    });

    // Mobile Drawer Drawer Controls
    const btnOpenDrawer = document.getElementById('btn_open_drawer');
    const btnCloseDrawer = document.getElementById('btn_close_drawer');
    const drawerBackdrop = document.getElementById('mobile_drawer_backdrop');
    const mobileDrawer = document.getElementById('mobile_drawer');

    function openDrawer() {
      drawerBackdrop.classList.remove('hidden');
      setTimeout(() => {
        mobileDrawer.classList.remove('-translate-x-full');
      }, 10);
    }

    function closeDrawer() {
      mobileDrawer.classList.add('-translate-x-full');
      setTimeout(() => {
        drawerBackdrop.classList.add('hidden');
      }, 300);
    }

    if (btnOpenDrawer) btnOpenDrawer.addEventListener('click', openDrawer);
    if (btnCloseDrawer) btnCloseDrawer.addEventListener('click', closeDrawer);
    if (drawerBackdrop) {
      drawerBackdrop.addEventListener('click', (e) => {
        if (e.target === drawerBackdrop) closeDrawer();
      });
    }

    // Unsaved Changes Tracking
    let formChanged = false;
    const configForm = document.getElementById('configForm');
    const desktopStatus = document.getElementById('desktop_save_status');
    const mobileStatusText = document.getElementById('mobile_save_text');
    const mobileStatusIndicator = document.getElementById('mobile_unsaved_indicator');

    function markUnsaved() {
      if (!formChanged) {
        formChanged = true;
        if (desktopStatus) {
          desktopStatus.className = 'text-xs font-medium text-amber-400 flex items-center gap-1.5';
          desktopStatus.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span><span>Có thay đổi chưa lưu</span>';
        }
        if (mobileStatusText) mobileStatusText.textContent = 'Chưa lưu thay đổi';
        if (mobileStatusIndicator) mobileStatusIndicator.className = 'w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse';
      }
    }

    function markSaved() {
      formChanged = false;
      if (desktopStatus) {
        desktopStatus.className = 'text-xs font-medium text-emerald-400 flex items-center gap-1.5';
        desktopStatus.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span><span>Đã đồng bộ</span>';
      }
      if (mobileStatusText) mobileStatusText.textContent = 'Đã đồng bộ';
      if (mobileStatusIndicator) mobileStatusIndicator.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse';
    }

    if (configForm) {
      configForm.addEventListener('input', markUnsaved);
      configForm.addEventListener('change', markUnsaved);
    }

    // Live Banner Thumbnail Preview
    const welcomeBannerInput = document.getElementById('input_welcome_banner');
    const welcomeBannerPreview = document.getElementById('preview_welcome_banner');
    if (welcomeBannerInput && welcomeBannerPreview) {
      welcomeBannerInput.addEventListener('input', () => {
        const val = welcomeBannerInput.value.trim();
        welcomeBannerPreview.src = val || 'https://media.giphy.com/media/vVjkN5PFzWizSI3wKn/giphy.gif';
      });
    }

    const leaveBannerInput = document.getElementById('input_leave_banner');
    const leaveBannerPreview = document.getElementById('preview_leave_banner');
    if (leaveBannerInput && leaveBannerPreview) {
      leaveBannerInput.addEventListener('input', () => {
        const val = leaveBannerInput.value.trim();
        leaveBannerPreview.src = val || 'https://media.giphy.com/media/v1.Y2lkPTc5MGI3NjExYjEyaXlmYm1qcGcwNmFneXNjamZndjY0NHl4bHZjeGs2Z3JjNjUwayZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/Ru9sjtZ09XOEg/giphy.gif';
      });
    }

    // Submit Configuration via AJAX without reload
    async function submitConfiguration(e) {
      if (e) e.preventDefault();
      const formData = new FormData(configForm);
      const data = {};

      // Multi-select handling
      formData.forEach((value, key) => {
        if (data[key]) {
          if (!Array.isArray(data[key])) data[key] = [data[key]];
          data[key].push(value);
        } else {
          data[key] = value;
        }
      });

      const guildId = "<%= targetGuild.id %>";
      try {
        const res = await fetch(`/api/config/${guildId}?ajax=1`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
          },
          body: JSON.stringify(data),
        });

        const resData = await res.json().catch(() => ({ success: res.ok }));
        if (res.ok) {
          markSaved();
          showSanguinisAlert({
            icon: 'success',
            title: 'Lưu Thành Công',
            text: resData.message || '🩸 Toàn bộ cấu hình Huyết Ấn đã được cập nhật thành công!',
          });
        } else {
          showSanguinisAlert({
            icon: 'error',
            title: 'Lỗi Lưu Cấu Hình',
            text: resData.message || 'Không thể lưu cấu hình, vui lòng thử lại!',
          });
        }
      } catch (err) {
        showSanguinisAlert({
          icon: 'error',
          title: 'Mất Kết Nối',
          text: 'Lỗi giao tiếp với máy chủ Sanguinis!',
        });
      }
    }

    // Test Log for Specific Log Channels
    async function testLog(logType, selectName) {
      const selectEl = document.querySelector(`select[name="${selectName}"]`);
      const channelId = selectEl ? selectEl.value : '';
      const guildId = "<%= targetGuild.id %>";

      if (!channelId) {
        return showSanguinisAlert({
          icon: 'warning',
          title: 'Chưa Chọn Kênh',
          text: 'Vui lòng chọn Kênh Discord trước khi gửi tín hiệu Test Log!',
        });
      }

      try {
        const res = await fetch(`/api/test-log/${guildId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ logType, channelId }),
        });
        const data = await res.json();
        showSanguinisAlert({
          icon: res.ok ? 'success' : 'error',
          title: res.ok ? 'Thử Nghiệm Thành Công' : 'Lỗi Gửi Test',
          text: data.message,
        });
      } catch (err) {
        showSanguinisAlert({
          icon: 'error',
          title: 'Lỗi Kết Nối',
          text: 'Không thể kết nối đến Bot để gửi tín hiệu kiểm tra!',
        });
      }
    }

    // Test Welcome / Goodbye / DM
    async function sendCustomTest(type) {
      const guildId = "<%= targetGuild.id %>";
      let url = `/api/test-${type}/${guildId}`;
      let body = {};

      if (type === 'welcome') {
        const ch = document.querySelector('select[name="welcomeChannelId"]')?.value;
        const msg = document.querySelector('textarea[name="welcomeMessage"]')?.value;
        const banner = document.querySelector('input[name="welcomeBannerUrl"]')?.value;
        if (!ch) {
          return showSanguinisAlert({
            icon: 'warning',
            title: 'Chưa Chọn Kênh',
            text: 'Vui lòng chọn Kênh Chào Mừng trước khi gửi test!',
          });
        }
        body = { channelId: ch, message: msg, bannerUrl: banner };
      } else if (type === 'goodbye') {
        const ch = document.querySelector('select[name="leaveChannelId"]')?.value;
        const msg = document.querySelector('textarea[name="leaveMessage"]')?.value;
        const banner = document.querySelector('input[name="leaveBannerUrl"]')?.value;
        if (!ch) {
          return showSanguinisAlert({
            icon: 'warning',
            title: 'Chưa Chọn Kênh',
            text: 'Vui lòng chọn Kênh Tạm Biệt trước khi gửi test!',
          });
        }
        body = { channelId: ch, message: msg, bannerUrl: banner };
      } else if (type === 'dm-welcome') {
        const msg = document.querySelector('textarea[name="dmWelcomeMessage"]')?.value;
        if (!msg) {
          return showSanguinisAlert({
            icon: 'warning',
            title: 'Chưa Nhập Nội Dung',
            text: 'Vui lòng nhập nội dung Mật Thư DM Chào Mừng!',
          });
        }
        body = { message: msg };
      } else if (type === 'dm-leave') {
        const msg = document.querySelector('textarea[name="dmLeaveMessage"]')?.value;
        if (!msg) {
          return showSanguinisAlert({
            icon: 'warning',
            title: 'Chưa Nhập Nội Dung',
            text: 'Vui lòng nhập nội dung Mật Thư DM Tạm Biệt!',
          });
        }
        body = { message: msg };
      }

      try {
        const res = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        const data = await res.json();
        showSanguinisAlert({
          icon: res.ok ? 'success' : 'error',
          title: res.ok ? 'Thử Nghiệm Thành Công' : 'Lỗi Thử Nghiệm',
          text: data.message,
        });
      } catch (err) {
        showSanguinisAlert({
          icon: 'error',
          title: 'Lỗi Hệ Thống',
          text: 'Không thể kết nối đến Bot để gửi tin nhắn test!',
        });
      }
    }

    // Giveaway Functions
    const guildMembersDataElement = document.getElementById('guild-members-data');
    const guildMembers = guildMembersDataElement ? JSON.parse(guildMembersDataElement.textContent) : [];

    function updateRiggedSelects() {
      const winnersCount = parseInt(document.getElementById('gw_winners')?.value) || 1;
      const container = document.getElementById('rigged_container');
      if (!container) return;
      container.innerHTML = '';

      for (let i = 1; i <= winnersCount; i++) {
        let optionsHtml = `<option value="RANDOM">🎲 Top ${i}: Bốc Thăm Ngẫu Nhiên</option>`;
        guildMembers.forEach((m) => {
          optionsHtml += `<option value="${m.id}">🎯 Top ${i}: ${m.username} (${m.tag})</option>`;
        });

        const div = document.createElement('div');
        div.innerHTML = `
          <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider mb-1">Vị Trí Giải Top ${i}</label>
          <select class="rigged-select w-full h-11 bg-[#101016] border border-red-950/80 rounded-xl px-3 text-base md:text-sm text-white focus:border-purple-500 focus:outline-none">
            ${optionsHtml}
          </select>
        `;
        container.appendChild(div);
      }
    }

    const gwWinnersInput = document.getElementById('gw_winners');
    if (gwWinnersInput) {
      gwWinnersInput.addEventListener('input', updateRiggedSelects);
      updateRiggedSelects();
    }

    async function createGiveaway() {
      const channelId = document.getElementById('gw_channel')?.value;
      const prize = document.getElementById('gw_prize')?.value.trim();
      const duration = document.getElementById('gw_duration')?.value.trim();
      const winners = document.getElementById('gw_winners')?.value;
      const requiredRoleId = document.getElementById('gw_req_role')?.value;
      const minAccountAge = document.getElementById('gw_min_acc')?.value;
      const minServerAge = document.getElementById('gw_min_server')?.value;
      const minLevel = document.getElementById('gw_min_level')?.value;
      const minMessages = document.getElementById('gw_min_messages')?.value;
      const minParticipants = document.getElementById('gw_min_participants')?.value;
      const riggedWinners = Array.from(document.querySelectorAll('.rigged-select')).map((s) => s.value);

      if (!prize || !duration) {
        return showSanguinisAlert({
          icon: 'warning',
          title: 'Thiếu Thông Tin',
          text: 'Vui lòng nhập Tên Phần Thưởng và Thời Gian diễn ra!',
        });
      }

      const guildId = "<%= targetGuild.id %>";
      try {
        const res = await fetch(`/api/giveaway/create/${guildId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            channelId,
            prize,
            duration,
            winners,
            requiredRoleId,
            minAccountAge,
            minServerAge,
            minLevel,
            minMessages,
            minParticipants,
            riggedWinners,
          })
        });
        const data = await res.json();
        showSanguinisAlert({
          icon: data.success ? 'success' : 'error',
          title: data.success ? 'Khởi Tạo Thành Công' : 'Lỗi Khởi Tạo',
          text: data.message,
        });
        if (data.success) {
          setTimeout(() => location.reload(), 1500);
        }
      } catch (err) {
        showSanguinisAlert({
          icon: 'error',
          title: 'Lỗi Hệ Thống',
          text: 'Lỗi gửi yêu cầu tạo Giveaway!',
        });
      }
    }

    async function endGiveaway(messageId) {
      confirmSanguinisAction(
        'Kết Thúc Sự Kiện',
        'Bạn có chắc muốn kết thúc sớm sự kiện này và bốc thăm giải thưởng ngay lập tức?',
        async () => {
          try {
            const res = await fetch(`/api/giveaway/end/${messageId}`, { method: 'POST' });
            const data = await res.json();
            showSanguinisAlert({
              icon: res.ok ? 'success' : 'error',
              title: res.ok ? 'Đã Kết Thúc' : 'Lỗi',
              text: data.message,
            });
            if (res.ok) setTimeout(() => location.reload(), 1200);
          } catch (err) {
            showSanguinisAlert({
              icon: 'error',
              title: 'Lỗi Hệ Thống',
              text: 'Không thể kết thúc sự kiện Giveaway!',
            });
          }
        }
      );
    }

    async function rerollGiveaway(messageId) {
      confirmSanguinisAction(
        'Reroll Người Thắng',
        'Quay số lại để tìm một người chiến thắng mới từ danh sách tham gia?',
        async () => {
          try {
            const res = await fetch(`/api/giveaway/reroll/${messageId}`, { method: 'POST' });
            const data = await res.json();
            showSanguinisAlert({
              icon: res.ok ? 'success' : 'error',
              title: res.ok ? 'Reroll Thành Công' : 'Lỗi Reroll',
              text: data.message,
            });
          } catch (err) {
            showSanguinisAlert({
              icon: 'error',
              title: 'Lỗi Hệ Thống',
              text: 'Lỗi gửi yêu cầu Reroll Giveaway!',
            });
          }
        }
      );
    }

    async function deleteGiveaway(messageId) {
      confirmSanguinisAction(
        'Xóa Sự Kiện',
        'Bạn có chắc muốn xóa vĩnh viễn sự kiện này khỏi cơ sở dữ liệu?',
        async () => {
          try {
            const res = await fetch(`/api/giveaway/delete/${messageId}`, { method: 'POST' });
            const data = await res.json();
            showSanguinisAlert({
              icon: data.success ? 'success' : 'error',
              title: data.success ? 'Đã Xóa' : 'Lỗi',
              text: data.message,
            });
            if (data.success) setTimeout(() => location.reload(), 1200);
          } catch (err) {
            showSanguinisAlert({
              icon: 'error',
              title: 'Lỗi Hệ Thống',
              text: 'Không thể xóa Giveaway!',
            });
          }
        }
      );
    }
  </script>
</body>
</html>
