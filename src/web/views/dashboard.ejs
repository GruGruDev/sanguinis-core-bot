  <script id="guild-members-data" type="application/json">
    <%- JSON.stringify(guildMembers || []) %>
  </script>

  <script>
    const sanguinisSwal = Swal.mixin({
      customClass: {
        popup: 'sanguinis-swal',
        confirmButton: 'swal2-confirm',
        cancelButton: 'swal2-cancel',
      },
      buttonsStyling: false,
      backdrop: 'rgba(2, 4, 8, 0.72)',
      allowOutsideClick: true,
      color: '#f8fafc',
      background: 'rgba(17, 24, 39, 0.98)',
      confirmButtonText: 'Đồng ý',
      cancelButtonText: 'Hủy',
      reverseButtons: true,
    });

    function showSanguinisAlert({ icon = 'success', title = 'Thông báo', text = '', confirmButtonText = 'Đồng ý' } = {}) {
      return sanguinisSwal.fire({
        icon,
        title,
        text,
        confirmButtonText,
      });
    }

    function confirmSanguinisAction(title, text, callback) {
      sanguinisSwal
        .fire({
          icon: 'warning',
          title,
          text,
          showCancelButton: true,
          confirmButtonText: 'Xác nhận',
          cancelButtonText: 'Hủy',
        })
        .then((result) => {
          if (result.isConfirmed && typeof callback === 'function') {
            callback();
          }
        });
    }

    const guildMembersDataElement = document.getElementById('guild-members-data');
    const guildMembers = guildMembersDataElement ? JSON.parse(guildMembersDataElement.textContent) : [];

    function updateRiggedSelects() {
      const winnersCount = parseInt(document.getElementById('gw_winners').value) || 1;
      const container = document.getElementById('rigged_container');
      container.innerHTML = '';

      for (let i = 1; i <= winnersCount; i++) {
        let optionsHtml = `<option value="RANDOM">🎲 Top ${i}: Ngẫu Nhiên (Random)</option>`;
        guildMembers.forEach((m) => {
          optionsHtml += `<option value="${m.id}">🎯 Top ${i}: ${m.username} (${m.tag})</option>`;
        });

        const div = document.createElement('div');
        div.innerHTML = `
          <label class="block text-[11px] font-medium text-gray-400 mb-1">Vị Trí Giải Top ${i}</label>
          <select class="rigged-select w-full bg-[#10141d] border border-gray-800 rounded-lg p-2.5 text-xs text-white focus:border-pink-500 focus:outline-none">
            ${optionsHtml}
          </select>
        `;
        container.appendChild(div);
      }
    }

    document.getElementById('gw_winners').addEventListener('input', updateRiggedSelects);
    updateRiggedSelects();

    async function sendTest(type) {
      if (type === 'welcome') {
        const welcomeChannel = document.querySelector('select[name="welcomeChannelId"]').value;
        if (!welcomeChannel) {
          return showSanguinisAlert({
            icon: 'warning',
            title: 'Chưa Chọn Kênh',
            text: 'Vui lòng chọn Kênh Chào Mừng trước khi gửi tin nhắn thử nghiệm!',
          });
        }
      }

      if (type === 'goodbye') {
        const leaveChannel = document.querySelector('select[name="leaveChannelId"]').value;
        if (!leaveChannel) {
          return showSanguinisAlert({
            icon: 'warning',
            title: 'Chưa Chọn Kênh',
            text: 'Vui lòng chọn Kênh Tạm Biệt trước khi gửi tin nhắn thử nghiệm!',
          });
        }
      }

      const guildId = "<%= targetGuild.id %>";
      const url = `/api/test-${type}/${guildId}`;
      
      try {
        const res = await fetch(url, { method: 'POST' });
        const data = await res.json();
        showSanguinisAlert({
          icon: res.ok ? 'success' : 'error',
          title: res.ok ? 'Thành công' : 'Lỗi',
          text: data.message,
        });
      } catch (err) {
        showSanguinisAlert({
          icon: 'error',
          title: 'Không thể kết nối',
          text: 'Không thể kết nối đến máy chủ để gửi tin nhắn test!',
        });
      }
    }

    async function endGiveaway(messageId) {
      confirmSanguinisAction(
        'Kết thúc Giveaway',
        'Bạn có chắc muốn ép kết thúc ngay sự kiện Giveaway này?',
        async () => {
          try {
            const res = await fetch(`/api/giveaway/end/${messageId}`, { method: 'POST' });
            const data = await res.json();
            showSanguinisAlert({
              icon: res.ok ? 'success' : 'error',
              title: res.ok ? 'Thành công' : 'Lỗi',
              text: data.message,
            });
            if (res.ok) location.reload();
          } catch (err) {
            showSanguinisAlert({
              icon: 'error',
              title: 'Lỗi hệ thống',
              text: 'Lỗi gửi yêu cầu kết thúc Giveaway!',
            });
          }
        },
      );
    }

    async function rerollGiveaway(messageId) {
      try {
        const res = await fetch(`/api/giveaway/reroll/${messageId}`, { method: 'POST' });
        const data = await res.json();
        showSanguinisAlert({
          icon: res.ok ? 'success' : 'error',
          title: res.ok ? 'Reroll thành công' : 'Lỗi reroll',
          text: data.message,
        });
      } catch (err) {
        showSanguinisAlert({
          icon: 'error',
          title: 'Lỗi hệ thống',
          text: 'Lỗi gửi yêu cầu Reroll Giveaway!',
        });
      }
    }

    async function createGiveaway() {
      const channelId = document.getElementById('gw_channel').value;
      const prize = document.getElementById('gw_prize').value.trim();
      const duration = document.getElementById('gw_duration').value.trim();
      const winners = document.getElementById('gw_winners').value;
      const requiredRoleId = document.getElementById('gw_req_role').value;
      const minAccountAge = document.getElementById('gw_min_acc').value;
      const minServerAge = document.getElementById('gw_min_server').value;
      const minLevel = document.getElementById('gw_min_level').value;
      const minMessages = document.getElementById('gw_min_messages').value;
      const minParticipants = document.getElementById('gw_min_participants').value;
      const riggedWinners = Array.from(document.querySelectorAll('.rigged-select')).map((s) => s.value);

      if (!prize || !duration) {
        return showSanguinisAlert({
          icon: 'warning',
          title: 'Thiếu thông tin',
          text: 'Vui lòng nhập Tên Phần Thưởng và Thời Gian!',
        });
      }

      const guildId = "<%= targetGuild.id %>";
      try {
        const res = await fetch(`/api/giveaway/create/${guildId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            channelId,
            prize,
            duration,
            winners,
            requiredRoleId,
            minAccountAge,
            minServerAge,
            minLevel,
            minMessages,
            minParticipants,
            riggedWinners,
          })
        });
        const data = await res.json();
        showSanguinisAlert({
          icon: data.success ? 'success' : 'error',
          title: data.success ? 'Tạo Giveaway' : 'Lỗi',
          text: data.message,
        });
        if (data.success) location.reload();
      } catch (err) {
        showSanguinisAlert({
          icon: 'error',
          title: 'Lỗi hệ thống',
          text: 'Lỗi gửi yêu cầu tạo Giveaway!',
        });
      }
    }

    async function deleteGiveaway(messageId) {
      confirmSanguinisAction(
        'Xóa Giveaway',
        'Bạn có chắc muốn xóa bản ghi Giveaway này khỏi danh sách?',
        async () => {
          try {
            const res = await fetch(`/api/giveaway/delete/${messageId}`, { method: 'POST' });
            const data = await res.json();
            showSanguinisAlert({
              icon: data.success ? 'success' : 'error',
              title: data.success ? 'Đã xóa' : 'Lỗi',
              text: data.message,
            });
            if (data.success) location.reload();
          } catch (err) {
            showSanguinisAlert({
              icon: 'error',
              title: 'Lỗi hệ thống',
              text: 'Lỗi xóa Giveaway!',
            });
          }
        },
      );
    }
  </script>
</body>
</html>