            </div>
          </div>

          <!-- Section 3: Direct Messages (DM on Join & Leave) -->
          <div class="glass-card rounded-2xl p-5 sm:p-6 space-y-4">
            <h4 class="text-sm font-bold text-white uppercase tracking-wider pb-3 border-b border-red-950/40 flex items-center gap-2">
              <i class="fa-solid fa-envelope-open-text text-amber-500"></i>
              <span>3. Mật Thư Riêng (Direct Message)</span>
            </h4>

