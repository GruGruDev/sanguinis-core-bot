                      <input type="checkbox" name="dmWelcomeEnabled" value="1" <%= config.dm_welcome_enabled ? 'checked' : '' %> class="sr-only sanguinis-switch">
                      <div class="w-12 h-6 bg-gray-800 rounded-full border border-gray-700 switch-bg transition-colors duration-200"></div>
                      <div class="absolute left-1 top-1 w-4 h-4 bg-gray-400 rounded-full switch-dot transition-transform duration-200"></div>
                    </label>
                  </div>
                </div>
                <textarea name="dmWelcomeMessage" rows="3" placeholder="Nhập mật thư gửi thẳng vào DM thành viên mới..." class="w-full bg-[#101016] border border-red-950/80 rounded-xl p-3 text-base md:text-sm text-white focus:border-red-600 focus:outline-none"><%= config.dm_welcome_message || '' %></textarea>
